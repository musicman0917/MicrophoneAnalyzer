{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mic Level HUD",
  "version": "0.1.0",
  "identifier": "com.miclevelhud.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "hud",
        "title": "Mic Level HUD",
        "url": "hud/hud.html",
        "width": 190,
        "height": 480,
        "minWidth": 150,
        "minHeight": 130,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": false
      },
      {
        "label": "control",
        "title": "Mic Level HUD - Control Center",
        "url": "control/control.html",
        "width": 960,
        "height": 680,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
